<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_phone_autoformat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.phone.autoformat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Phone Auto Format" string="Phone Auto Format" name="phone_autoformat" groups="base.group_system">
                    <block title="Phone Number Formatting" name="phone_autoformat_block">
                        <setting string="Number format" id="phone_autoformat_format_setting"
                                 help="How phone numbers are written once saved. Numbers typed without a + use the contact's country, or the company's country as a fallback.">
                            <field name="phone_autoformat_format" class="o_light_label"/>
                        </setting>
                        <setting string="Numbers per field" id="phone_autoformat_multiple_setting"
                                 help="Choose whether one phone field may hold several numbers separated by commas.">
                            <field name="phone_autoformat_multiple" class="o_light_label"/>
                        </setting>
                        <div class="mt-3 text-muted small">
                            Developed by <strong>Syed Sameed Zafar</strong> &#8211;
                            <a href="mailto:sameedzfr@gmail.com">sameedzfr@gmail.com</a> &#8211;
                            <a href="https://syed-sameed-zafar.vercel.app/" target="_blank" rel="noopener">syed-sameed-zafar.vercel.app</a>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
